{
  "name": "opencode-for-copilot",
  "displayName": "OpenCode for Copilot",
  "description": "Use OpenCode Go & Zen coding models (GLM, Kimi, DeepSeek, Claude, Grok, Qwen, free models) in the Copilot Chat model picker. Vision, thinking mode, agent tools — zero config, BYOK.",
  "icon": "resources/icon.png",
  "version": "3.11.0",
  "packageManager": "pnpm@11.7.0",
  "publisher": "abbalochdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abbalochdev/opencode-for-copilot.git"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24.11.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "opencode",
    "opencode go",
    "glm",
    "glm 5",
    "glm-5",
    "kimi",
    "deepseek",
    "qwen",
    "minimax",
    "mimo",
    "copilot",
    "github copilot",
    "copilot chat",
    "vision",
    "byok",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "opencode",
        "displayName": "OpenCode"
      }
    ],
    "chatParticipants": [
      {
        "id": "opencode-for-copilot.pipeline",
        "name": "swarm",
        "fullName": "OpenCode Agent Swarm",
        "description": "Runs the agent swarm: parallel research agents, pre-implementation review, then implementation on the current model."
      }
    ],
    "commands": [
      {
        "command": "opencode-for-copilot.setGoApiKey",
        "title": "%opencode-for-copilot.command.setGoApiKey%"
      },
      {
        "command": "opencode-for-copilot.setZenApiKey",
        "title": "%opencode-for-copilot.command.setZenApiKey%"
      },
      {
        "command": "opencode-for-copilot.getApiKey",
        "title": "%opencode-for-copilot.command.getApiKey%"
      },
      {
        "command": "opencode-for-copilot.queryUsage",
        "title": "%opencode-for-copilot.command.queryUsage%"
      },
      {
        "command": "opencode-for-copilot.clearApiKey",
        "title": "%opencode-for-copilot.command.clearApiKey%"
      },
      {
        "command": "opencode-for-copilot.setVisionModel",
        "title": "%opencode-for-copilot.command.setVisionModel%"
      },
      {
        "command": "opencode-for-copilot.openSettings",
        "title": "%opencode-for-copilot.command.openSettings%"
      },
      {
        "command": "opencode-for-copilot.showLogs",
        "title": "%opencode-for-copilot.command.showLogs%"
      },
      {
        "command": "opencode-for-copilot.showDiagnostics",
        "title": "%opencode-for-copilot.command.showDiagnostics%"
      },
      {
        "command": "opencode-for-copilot.openRequestDumpsFolder",
        "title": "%opencode-for-copilot.command.openRequestDumpsFolder%"
      },
      {
        "command": "opencode-for-copilot.setPonytailMode",
        "title": "%opencode-for-copilot.command.setPonytailMode%"
      },
      {
        "command": "opencode-for-copilot.toggleCodeSimplifier",
        "title": "%opencode-for-copilot.command.toggleCodeSimplifier%"
      },
      {
        "command": "opencode-for-copilot.refreshModels",
        "title": "%opencode-for-copilot.command.refreshModels%"
      }
    ],
    "walkthroughs": [
      {
        "id": "glmGettingStarted",
        "title": "%opencode-for-copilot.walkthrough.title%",
        "description": "%opencode-for-copilot.walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%opencode-for-copilot.walkthrough.setApiKey.title%",
            "description": "%opencode-for-copilot.walkthrough.setApiKey.description%",
            "media": {
              "markdown": "resources/walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:opencode-for-copilot.setGoApiKey"
            ]
          },
          {
            "id": "showModels",
            "title": "%opencode-for-copilot.walkthrough.showModels.title%",
            "description": "%opencode-for-copilot.walkthrough.showModels.description%",
            "media": {
              "markdown": "resources/walkthrough/show-models.md"
            }
          },
          {
            "id": "advancedSettings",
            "title": "%opencode-for-copilot.walkthrough.advancedSettings.title%",
            "description": "%opencode-for-copilot.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "resources/walkthrough/advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%opencode-for-copilot.config.title%",
      "properties": {
        "opencode-for-copilot.opencodePlan": {
          "type": "string",
          "enum": [
            "go",
            "zen"
          ],
          "default": "go",
          "markdownDescription": "%opencode-for-copilot.config.opencodePlan.description%"
        },
        "opencode-for-copilot.agentRoles": {
          "type": "object",
          "default": {},
          "markdownDescription": "%opencode-for-copilot.config.agentRoles.description%",
          "properties": {
            "research": {
              "type": "array",
              "markdownDescription": "%opencode-for-copilot.config.agentRoles.research.description%",
              "items": {
                "type": "object",
                "required": [
                  "vendor",
                  "family"
                ],
                "additionalProperties": false,
                "properties": {
                  "vendor": {
                    "type": "string"
                  },
                  "family": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            },
            "review": {
              "type": "array",
              "markdownDescription": "%opencode-for-copilot.config.agentRoles.review.description%",
              "items": {
                "type": "object",
                "required": [
                  "vendor",
                  "family"
                ],
                "additionalProperties": false,
                "properties": {
                  "vendor": {
                    "type": "string"
                  },
                  "family": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "opencode-for-copilot.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%opencode-for-copilot.config.baseUrl.description%"
        },
        "opencode-for-copilot.endpoint": {
          "type": "string",
          "default": "opencode-go",
          "enum": [
            "opencode-go",
            "opencode-go-anthropic",
            "opencode-zen",
            "opencode-zen-anthropic",
            "china-coding",
            "china-standard",
            "china-anthropic",
            "international-coding",
            "international-standard",
            "international-anthropic"
          ],
          "enumItemLabels": [
            "%opencode-for-copilot.config.endpoint.opencodeGo.label%",
            "%opencode-for-copilot.config.endpoint.opencodeGoAnthropic.label%",
            "%opencode-for-copilot.config.endpoint.opencodeZen.label%",
            "%opencode-for-copilot.config.endpoint.opencodeZenAnthropic.label%",
            "%opencode-for-copilot.config.endpoint.chinaCoding.label%",
            "%opencode-for-copilot.config.endpoint.chinaStandard.label%",
            "%opencode-for-copilot.config.endpoint.chinaAnthropic.label%",
            "%opencode-for-copilot.config.endpoint.internationalCoding.label%",
            "%opencode-for-copilot.config.endpoint.internationalStandard.label%",
            "%opencode-for-copilot.config.endpoint.internationalAnthropic.label%"
          ],
          "markdownEnumDescriptions": [
            "%opencode-for-copilot.config.endpoint.opencodeGo.description%",
            "%opencode-for-copilot.config.endpoint.opencodeGoAnthropic.description%",
            "%opencode-for-copilot.config.endpoint.opencodeZen.description%",
            "%opencode-for-copilot.config.endpoint.opencodeZenAnthropic.description%",
            "%opencode-for-copilot.config.endpoint.chinaCoding.description%",
            "%opencode-for-copilot.config.endpoint.chinaStandard.description%",
            "%opencode-for-copilot.config.endpoint.chinaAnthropic.description%",
            "%opencode-for-copilot.config.endpoint.internationalCoding.description%",
            "%opencode-for-copilot.config.endpoint.internationalStandard.description%",
            "%opencode-for-copilot.config.endpoint.internationalAnthropic.description%"
          ],
          "markdownDescription": "%opencode-for-copilot.config.endpoint.description%"
        },
        "opencode-for-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%opencode-for-copilot.config.maxTokens.description%"
        },
        "opencode-for-copilot.showProviderPrefix": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%opencode-for-copilot.config.showProviderPrefix.description%"
        },
        "opencode-for-copilot.experimental.stabilizeToolList": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%opencode-for-copilot.config.experimental.stabilizeToolList.description%",
          "tags": [
            "experimental"
          ]
        },
        "opencode-for-copilot.modelIdOverrides": {
          "type": "object",
          "default": {
            "copilot-utility": "deepseek-v4-flash",
            "copilot-utility-small": "deepseek-v4-flash"
          },
          "markdownDescription": "%opencode-for-copilot.config.modelIdOverrides.description%",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "copilot-utility": {
              "type": "string",
              "description": "API model ID for Copilot Chat utility model (quick inline tasks)."
            },
            "copilot-utility-small": {
              "type": "string",
              "description": "API model ID for Copilot Chat small utility model."
            }
          }
        },
        "opencode-for-copilot.customModels": {
          "type": "array",
          "default": [],
          "markdownDescription": "%opencode-for-copilot.config.customModels.description%",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "description": "%opencode-for-copilot.config.customModels.string.description%"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "%opencode-for-copilot.config.customModels.id.description%"
                  },
                  "name": {
                    "type": "string",
                    "description": "%opencode-for-copilot.config.customModels.name.description%"
                  },
                  "maxInputTokens": {
                    "type": "number",
                    "minimum": 1,
                    "description": "%opencode-for-copilot.config.customModels.maxInputTokens.description%"
                  },
                  "maxOutputTokens": {
                    "type": "number",
                    "minimum": 1,
                    "description": "%opencode-for-copilot.config.customModels.maxOutputTokens.description%"
                  },
                  "toolCalling": {
                    "type": "boolean",
                    "description": "%opencode-for-copilot.config.customModels.toolCalling.description%"
                  },
                  "thinking": {
                    "type": "boolean",
                    "description": "%opencode-for-copilot.config.customModels.thinking.description%"
                  }
                }
              }
            ]
          }
        },
        "opencode-for-copilot.visionModel": {
          "type": "string",
          "default": "",
          "tags": [
            "advanced"
          ],
          "markdownDescription": "%opencode-for-copilot.config.visionModel.description%"
        },
        "opencode-for-copilot.visionPrompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "Describe all image attachments in this message.\n\nIf there is one image, describe it directly.\nIf there are multiple images:\n1. Describe each image separately, preserving their order.\n2. Then provide a combined description explaining the overall context and relationships across the images.\n\nReturn one concise factual description suitable for inserting into a text-only chat prompt. Include visible text, objects, UI elements, people, and relevant context. Do not invent details.",
          "markdownDescription": "%opencode-for-copilot.config.visionPrompt.description%"
        },
        "opencode-for-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumItemLabels": [
            "%opencode-for-copilot.config.debugMode.minimal.label%",
            "%opencode-for-copilot.config.debugMode.metadata.label%",
            "%opencode-for-copilot.config.debugMode.verbose.label%"
          ],
          "markdownEnumDescriptions": [
            "%opencode-for-copilot.config.debugMode.minimal.description%",
            "%opencode-for-copilot.config.debugMode.metadata.description%",
            "%opencode-for-copilot.config.debugMode.verbose.description%"
          ],
          "markdownDescription": "%opencode-for-copilot.config.debugMode.description%"
        },
        "opencode-for-copilot.ponytailMode": {
          "type": "string",
          "default": "full",
          "enum": [
            "off",
            "lite",
            "full",
            "ultra"
          ],
          "enumItemLabels": [
            "%opencode-for-copilot.config.ponytailMode.off.label%",
            "%opencode-for-copilot.config.ponytailMode.lite.label%",
            "%opencode-for-copilot.config.ponytailMode.full.label%",
            "%opencode-for-copilot.config.ponytailMode.ultra.label%"
          ],
          "markdownEnumDescriptions": [
            "%opencode-for-copilot.config.ponytailMode.off.description%",
            "%opencode-for-copilot.config.ponytailMode.lite.description%",
            "%opencode-for-copilot.config.ponytailMode.full.description%",
            "%opencode-for-copilot.config.ponytailMode.ultra.description%"
          ],
          "markdownDescription": "%opencode-for-copilot.config.ponytailMode.description%"
        },
        "opencode-for-copilot.codeSimplifier": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%opencode-for-copilot.config.codeSimplifier.description%"
        },
        "opencode-for-copilot.stripThinkTags": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumItemLabels": [
            "%opencode-for-copilot.config.stripThinkTags.auto.label%",
            "%opencode-for-copilot.config.stripThinkTags.always.label%",
            "%opencode-for-copilot.config.stripThinkTags.never.label%"
          ],
          "markdownEnumDescriptions": [
            "%opencode-for-copilot.config.stripThinkTags.auto.description%",
            "%opencode-for-copilot.config.stripThinkTags.always.description%",
            "%opencode-for-copilot.config.stripThinkTags.never.description%"
          ],
          "markdownDescription": "%opencode-for-copilot.config.stripThinkTags.description%"
        },
        "opencode-for-copilot.rules": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "markdownDescription": "%opencode-for-copilot.config.rules.description%"
        },
        "opencode-for-copilot.allowExtraTools": {
          "type": "boolean",
          "default": false,
          "tags": ["experimental"],
          "markdownDescription": "%opencode-for-copilot.config.allowExtraTools.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "vp pack",
    "watch": "vp pack --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp lint",
    "format": "vp fmt --write src/ test/ vite.config.mts",
    "format:check": "vp fmt --check src/ test/ vite.config.mts",
    "validate:models": "tsx scripts/validate-models.mts",
    "package": "vp run vsix"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "1.0.2",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.1",
    "vitest": "4.1.9"
  }
}